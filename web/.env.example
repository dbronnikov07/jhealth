# Copy to .env.local and fill in. Never commit .env.local or paste these values into a chat.

# --- Database ---------------------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Leave empty to use the local PGlite database in ~/jhealth-cache/pglite-dev instead.
DATABASE_URL=

# --- Doctor dashboard ---------------------------------------------------------------------------
# Password for the dashboard (the browser asks for it; any user name works). Required in production.
DASHBOARD_PASSWORD=

# --- WhatsApp Cloud API (README: "WhatsApp") ---------------------------------------------------
# Meta developer app -> WhatsApp -> API Setup. Leave empty and messages simply stay queued.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings -> Basic -> App secret. Proves that webhooks really come from Meta. Required in production.
WHATSAPP_APP_SECRET=
# Any random string you choose; type the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Public https address of this app (Vercel URL or tunnel). Used for the "Start session" button link.
PUBLIC_APP_URL=
# Optional: WHATSAPP_API_VERSION (default v27.0) and WHATSAPP_API_BASE (default https://graph.facebook.com;
# tests point it at the fake API from `npm run mock:whatsapp`).

# --- AI coach replies (README: "The AI coach") -------------------------------------------------
# adaptionlabs.ai -> Settings -> API keys. Leave empty and the coach stays silent (the pain rule still works).
ADAPTION_API_KEY=
# Optional: which hosted model answers (default in src/lib/coach/adaption.ts; compare with `npm run coach:eval`).
ADAPTION_MODEL=
