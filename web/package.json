{
  "name": "motiva-health-web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "db:verify": "node scripts/verify-db.mjs",
    "voice:fast": "$HOME/jhealth-cache/tts/venv/bin/python -I scripts/voice-dev.py",
    "voice:dev": "$HOME/jhealth-cache/tts/venv/bin/python -I scripts/voice-dev.py",
    "test:unit": "node --test scripts/whatsapp.test.ts scripts/pose.test.ts scripts/reps.test.ts scripts/loader.test.ts scripts/coach.test.ts scripts/exercises.test.ts scripts/engagement.test.ts scripts/auth.test.ts scripts/demo-phone.test.ts scripts/camera.test.ts scripts/imessage.test.ts scripts/live.test.ts scripts/speech.test.ts scripts/voice.test.ts scripts/fall.test.ts scripts/listen.test.ts",
    "coach:eval": "node scripts/coach-eval.ts",
    "mock:whatsapp": "node scripts/mock-whatsapp.mjs",
    "fake:whatsapp": "node scripts/fake-whatsapp.mjs",
    "reminders": "curl -s 'http://localhost:3100/api/cron/reminders?force=1' && echo",
    "demo:reset": "node scripts/reset-demo.mjs",
    "cloud:migrate": "node scripts/db-remote.mjs migrate",
    "cloud:check": "node scripts/db-remote.mjs check",
    "cloud:demo-reset": "node scripts/db-remote.mjs reset-demo",
    "cloud:deploy": "BASE=http://localhost:3100 bash scripts/attack.sh && node --test scripts/auth.test.ts && vercel deploy --prod",
    "imessage:bridge": "node scripts/imessage-bridge.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@mediapipe/tasks-vision": "1.2.2",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
